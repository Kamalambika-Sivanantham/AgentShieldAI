# AgentShield AI — Backend Environment Variables

# Optional custom database path/URL (defaults to local SQLite: backend/agentshield.db)
DATABASE_URL=

# Optional Google Gemini API Key (for LLM-assisted scenario generation)
GEMINI_API_KEY=

# Allowed CORS origins, comma-separated (e.g., https://your-frontend.vercel.app,http://localhost:5173 or * for all)
CORS_ORIGINS=*

# Server Port (defaults to 8000; cloud platforms like Render/Railway/Fly automatically inject PORT)
PORT=8000
